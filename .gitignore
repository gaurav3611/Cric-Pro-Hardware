.DS_Store
__pycache__/
*.pyc
# build output, if a tool is pointed at this folder
/build/
*.o

# The guides and the stage pages are published as PDF. Their Markdown sources stay on the
# author's computer. README.md at the top is the one Markdown document that is published.
/docs/*.md
/stages/*/README.md

# KiCad's own working files: window settings, backups, caches and locks
/pcb/*.kicad_prl
/pcb/*-backups/
/pcb/fp-info-cache
/pcb/~*.lck
/pcb/_autosave-*
/pcb/#auto_saved_files#

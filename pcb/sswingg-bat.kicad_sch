(text "SSwinGG bat sensor. The circuit of hardware/diagrams/make_diagrams.py (NETS); tools/check.mjs compares the two." (exclude_from_sim no) (at 25.4 30.48 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "1e2c9982-90dd-5cf1-9afb-5619d8d18cf7"))
(text "BT1 is off the board and plugs into J1. U3, the charger module, sits on the board, wired to four pads; charge through its USB-C." (exclude_from_sim no) (at 25.4 35.56 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "7b423fae-375f-5bee-85d7-0f8412425b1e"))
(text "D1 lets the battery and the ESP32's USB cable be connected at once. C2 holds 5V up while the radio sends." (exclude_from_sim no) (at 25.4 40.64 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "13ccdcbd-8186-5d51-8305-88507ef73252"))
(text "Optional, stage 7: the battery voltage, halved, on GPIO0." (exclude_from_sim no) (at 93.98 111.76 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "1c5da232-0855-55ad-976a-2bb5f82d4876"))
(text "Mounting holes, 2.2 mm, for M2 screws or a cable tie." (exclude_from_sim no) (at 25.4 165.1 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "27393dd9-4f40-5bdf-a22c-8baedb6ad892"))
